pipeline {
    agent {
        node {
            labels "slave"
        }
    }
    tools {
        maven "jenkins-maven"
    }

    environment {
        NAME="ansh"
    }
    stages {
        stage("build") {
            steps {
                sh "builing package"
                sh "echo ${NAME}"
            }
        }
        stage("running test cases") {
            steps {
                sh "testing cases is running"
            }
        }
        stage("testing server") {
            steps {
                sh "deploying to testing server"
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: '1f1d29a4-212b-43b5-9dae-d4da0b4edfb4', path: '', url: 'http://192.168.247.152:8082/')], contextPath: 'page/', war: '**/*.war'
            }
        }
        stage("production server") {
            input {
                message "shoud we continue"
                ok "continue"
                }
            steps {
                sh "deploying to production server"
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: '1f1d29a4-212b-43b5-9dae-d4da0b4edfb4', path: '', url: 'http://192.168.247.152:8082/')], contextPath: 'page/', war: '**/*.war'
            }
        }

    }
    post {
        always {
            echo "pipeline is running"
        }
        failure {
            echo "pipeline got fail"
        }
        success{
            echo "pipeline got successful"
        }
    }
}
